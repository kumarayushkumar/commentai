{
  "name": "commentkit",
  "displayName": "CommentKit",
  "version": "0.0.2",
  "description": "Automatically comments on LinkedIn posts using AI.",
  "author": "ayushkumar",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@google/genai": "^1.27.0",
    "@plasmohq/storage": "^1.15.0",
    "i": "^0.3.7",
    "npm": "^11.6.2",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://www.linkedin.com/*",
      "https://linkedin.com/*"
    ],
    "permissions": [
      "storage",
      "sidePanel",
      "notifications"
    ]
  }
}
